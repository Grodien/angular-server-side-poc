# -> /etc/bergportal/web.env  (chmod 600, owner bergportal)
# The SSR server talks to the API over loopback.
API_BASE_URL=http://127.0.0.1:3000

# API key injected server-side (never exposed to the browser).
# Must match the API's key. Do not commit real keys.
API_KEY=your-api-key

# SSR server port (Nginx proxies to this).
PORT=4000

# Hosts allowed to reach the SSR engine (comma-separated).
# Set this to your public domain(s).
NG_ALLOWED_HOSTS=example.com,www.example.com
