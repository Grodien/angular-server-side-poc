# -> /etc/bergportal/api.env  (chmod 600, owner bergportal)
# PostgreSQL connection
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=driver_advisory_system
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# API server
# Bind to loopback only so the API is not reachable from outside the host.
HOST=127.0.0.1
PORT=3000

# Static API key (replace for production; do not commit real keys)
API_KEY=your-api-key
